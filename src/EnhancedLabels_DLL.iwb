    POINTER pCtrl
    pCtrl = ptr
    IF pCtrl == NULL THEN RETURN FALSE
    #<ENHANCED_LABEL>pCtrl.linkCount = 0
    #<ENHANCED_LABEL>pCtrl.linkBarCount = 0
    #<ENHANCED_LABEL>pCtrl.hoveredLinkIndex = -1
    #<ENHANCED_LABEL>pCtrl.pressedLinkIndex = -1
    #<ENHANCED_LABEL>pCtrl.hoveredBarIndex = -1
    #<ENHANCED_LABEL>pCtrl.pressedBarIndex = -1
    #<ENHANCED_LABEL>pCtrl.scrollOffset = 0
    HideCustomTooltip(ptr)
    RedrawWindow(#<ENHANCED_LABEL>pCtrl.hwndCtrl, NULL, NULL, RDW_INVALIDATE | RDW_UPDATENOW)
    RETURN TRUE
ENDSUB

SUB EL_RemoveLink(ptr:POINTER, cmdID:UINT), INT
    POINTER pCtrl
    pCtrl = ptr
    IF pCtrl == NULL THEN RETURN FALSE
    INT foundIdx = -1, i
    FOR i = 0 TO #<ENHANCED_LABEL>pCtrl.linkCount - 1
        IF #<ENHANCED_LABEL>pCtrl.links[i].cmdID == cmdID THEN
            foundIdx = i
            BREAKFOR
        ENDIF
    NEXT i
    IF foundIdx <> -1 THEN
        FOR i = foundIdx TO #<ENHANCED_LABEL>pCtrl.linkCount - 2
            #<ENHANCED_LABEL>pCtrl.links[i] = #<ENHANCED_LABEL>pCtrl.links[i + 1]
        NEXT i
        #<ENHANCED_LABEL>pCtrl.linkCount = #<ENHANCED_LABEL>pCtrl.linkCount - 1
        #<ENHANCED_LABEL>pCtrl.hoveredLinkIndex = -1
        #<ENHANCED_LABEL>pCtrl.pressedLinkIndex = -1
        HideCustomTooltip(ptr)
        RedrawWindow(#<ENHANCED_LABEL>pCtrl.hwndCtrl, NULL, NULL, RDW_INVALIDATE | RDW_UPDATENOW)
        RETURN TRUE
    ENDIF
    RETURN FALSE
ENDSUB

