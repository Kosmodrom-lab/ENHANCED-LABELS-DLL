    #<ENHANCED_LABEL>pCtrl.showVertSeparator = FALSE
    #<ENHANCED_LABEL>pCtrl.vertSeparatorColor = RGB(100, 116, 139)
    #<ENHANCED_LABEL>pCtrl.vertSeparatorWidth = 1
    #<ENHANCED_LABEL>pCtrl.vertSeparatorIndent = 120
    #<ENHANCED_LABEL>pCtrl.hHeaderBgBitmap = 0
