    #<ENHANCED_LABEL>pCtrl.isDraggingThumb = FALSE
    #<ENHANCED_LABEL>pCtrl.headerHighlightStyle = EL_HIGHLIGHT_BORDER_ONLY

    #<ENHANCED_LABEL>pCtrl.themeLinkTextColor      = RGB(248, 250, 252)
    #<ENHANCED_LABEL>pCtrl.themeLinkHighlightColor  = RGB(56, 189, 248)
    #<ENHANCED_LABEL>pCtrl.themeLinkBgColor         = RGB(30, 41, 59)
    #<ENHANCED_LABEL>pCtrl.themeBarTextColor        = RGB(226, 232, 240)
    #<ENHANCED_LABEL>pCtrl.themeBarHighlightColor   = RGB(56, 189, 248)
