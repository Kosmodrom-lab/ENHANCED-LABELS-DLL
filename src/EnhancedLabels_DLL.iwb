SUB EL_ApplyTheme(ptr:POINTER, themeID:INT)
    POINTER pCtrl
    pCtrl = ptr
    IF pCtrl == NULL THEN RETURN

    INT i
    UINT catBgColor, catTextColor

    SELECT themeID
        CASE EL_THEME_DARK_SLATE
            #<ENHANCED_LABEL>pCtrl.headerGradColor1     = RGB(30, 41, 59)
            #<ENHANCED_LABEL>pCtrl.headerGradColor2     = RGB(15, 23, 42)
            #<ENHANCED_LABEL>pCtrl.headerGradVertical   = TRUE
            #<ENHANCED_LABEL>pCtrl.headerTextColor       = RGB(248, 250, 252)
            #<ENHANCED_LABEL>pCtrl.headerDescTextColor   = RGB(148, 163, 184)
            #<ENHANCED_LABEL>pCtrl.bodyBgColor           = RGB(15, 23, 42)
            #<ENHANCED_LABEL>pCtrl.useBodyGradient       = FALSE
            
            #<ENHANCED_LABEL>pCtrl.themeLinkTextColor    = RGB(248, 250, 252)
            #<ENHANCED_LABEL>pCtrl.themeLinkHighlightColor = RGB(56, 189, 248)
            #<ENHANCED_LABEL>pCtrl.themeLinkBgColor       = RGB(30, 41, 59)
            
            #<ENHANCED_LABEL>pCtrl.linkBarGradColor1     = RGB(30, 41, 59)
            #<ENHANCED_LABEL>pCtrl.linkBarGradColor2     = RGB(15, 23, 42)
            #<ENHANCED_LABEL>pCtrl.linkBarGradVertical   = TRUE
            
            #<ENHANCED_LABEL>pCtrl.themeScrollTrackColor = RGB(30, 41, 59)
            #<ENHANCED_LABEL>pCtrl.themeScrollThumbColor = RGB(71, 85, 105)
            
            #<ENHANCED_LABEL>pCtrl.themeTTBgColor        = RGB(15, 23, 42)
            #<ENHANCED_LABEL>pCtrl.themeTTTextColor      = RGB(248, 250, 252)
            #<ENHANCED_LABEL>pCtrl.themeTTGlowColor       = RGB(56, 189, 248)

            catBgColor   = RGB(30, 41, 59)
            catTextColor = RGB(56, 189, 248)

        CASE EL_THEME_OFFICE_BLUE
            #<ENHANCED_LABEL>pCtrl.headerGradColor1     = RGB(219, 234, 254)
            #<ENHANCED_LABEL>pCtrl.headerGradColor2     = RGB(191, 219, 254)
            #<ENHANCED_LABEL>pCtrl.headerGradVertical   = TRUE
            #<ENHANCED_LABEL>pCtrl.headerTextColor       = RGB(30, 58, 138)
            #<ENHANCED_LABEL>pCtrl.headerDescTextColor   = RGB(29, 78, 216)
            #<ENHANCED_LABEL>pCtrl.bodyBgColor           = RGB(239, 246, 255)
            #<ENHANCED_LABEL>pCtrl.useBodyGradient       = FALSE
            
            #<ENHANCED_LABEL>pCtrl.themeLinkTextColor    = RGB(30, 58, 138)
            #<ENHANCED_LABEL>pCtrl.themeLinkHighlightColor = RGB(29, 78, 216)
            #<ENHANCED_LABEL>pCtrl.themeLinkBgColor       = RGB(219, 234, 254)
            
            #<ENHANCED_LABEL>pCtrl.linkBarGradColor1     = RGB(219, 234, 254)
            #<ENHANCED_LABEL>pCtrl.linkBarGradColor2     = RGB(191, 219, 254)
            #<ENHANCED_LABEL>pCtrl.linkBarGradVertical   = TRUE
            
            #<ENHANCED_LABEL>pCtrl.themeScrollTrackColor = RGB(219, 234, 254)
            #<ENHANCED_LABEL>pCtrl.themeScrollThumbColor = RGB(147, 197, 253)
            
            #<ENHANCED_LABEL>pCtrl.themeTTBgColor        = RGB(239, 246, 255)
            #<ENHANCED_LABEL>pCtrl.themeTTTextColor      = RGB(30, 58, 138)
            #<ENHANCED_LABEL>pCtrl.themeTTGlowColor       = RGB(29, 78, 216)

            catBgColor   = RGB(191, 219, 254)
            catTextColor = RGB(30, 58, 138)

        CASE EL_THEME_GLASS_MINIMAL
            #<ENHANCED_LABEL>pCtrl.headerGradColor1     = RGB(241, 245, 249)
            #<ENHANCED_LABEL>pCtrl.headerGradColor2     = RGB(226, 232, 240)
            #<ENHANCED_LABEL>pCtrl.headerGradVertical   = TRUE
            #<ENHANCED_LABEL>pCtrl.headerTextColor       = RGB(15, 23, 42)
            #<ENHANCED_LABEL>pCtrl.headerDescTextColor   = RGB(71, 85, 105)
            #<ENHANCED_LABEL>pCtrl.bodyBgColor           = RGB(255, 255, 255)
            #<ENHANCED_LABEL>pCtrl.useBodyGradient       = FALSE
            
            #<ENHANCED_LABEL>pCtrl.themeLinkTextColor    = RGB(15, 23, 42)
            #<ENHANCED_LABEL>pCtrl.themeLinkHighlightColor = RGB(2, 132, 199)
            #<ENHANCED_LABEL>pCtrl.themeLinkBgColor       = RGB(241, 245, 249)
            
            #<ENHANCED_LABEL>pCtrl.linkBarGradColor1     = RGB(241, 245, 249)
            #<ENHANCED_LABEL>pCtrl.linkBarGradColor2     = RGB(226, 232, 240)
            #<ENHANCED_LABEL>pCtrl.linkBarGradVertical   = TRUE
            
            #<ENHANCED_LABEL>pCtrl.themeScrollTrackColor = RGB(241, 245, 249)
            #<ENHANCED_LABEL>pCtrl.themeScrollThumbColor = RGB(203, 213, 225)
            
            #<ENHANCED_LABEL>pCtrl.themeTTBgColor        = RGB(255, 255, 255)
            #<ENHANCED_LABEL>pCtrl.themeTTTextColor      = RGB(15, 23, 42)
            #<ENHANCED_LABEL>pCtrl.themeTTGlowColor       = RGB(2, 132, 199)

            catBgColor   = RGB(226, 232, 240)
            catTextColor = RGB(15, 23, 42)

        CASE EL_THEME_CRIMSON_DARK
            #<ENHANCED_LABEL>pCtrl.headerGradColor1     = RGB(136, 19, 55)
            #<ENHANCED_LABEL>pCtrl.headerGradColor2     = RGB(76, 5, 25)
            #<ENHANCED_LABEL>pCtrl.headerGradVertical   = TRUE
            #<ENHANCED_LABEL>pCtrl.headerTextColor       = RGB(255, 241, 242)
            #<ENHANCED_LABEL>pCtrl.headerDescTextColor   = RGB(251, 113, 133)
            #<ENHANCED_LABEL>pCtrl.bodyBgColor           = RGB(30, 10, 15)
            #<ENHANCED_LABEL>pCtrl.useBodyGradient       = FALSE
            
            #<ENHANCED_LABEL>pCtrl.themeLinkTextColor    = RGB(255, 241, 242)
            #<ENHANCED_LABEL>pCtrl.themeLinkHighlightColor = RGB(251, 113, 133)
            #<ENHANCED_LABEL>pCtrl.themeLinkBgColor       = RGB(76, 5, 25)
            
            #<ENHANCED_LABEL>pCtrl.linkBarGradColor1     = RGB(136, 19, 55)
            #<ENHANCED_LABEL>pCtrl.linkBarGradColor2     = RGB(76, 5, 25)
            #<ENHANCED_LABEL>pCtrl.linkBarGradVertical   = TRUE
            
            #<ENHANCED_LABEL>pCtrl.themeScrollTrackColor = RGB(76, 5, 25)
            #<ENHANCED_LABEL>pCtrl.themeScrollThumbColor = RGB(159, 18, 57)
            
            #<ENHANCED_LABEL>pCtrl.themeTTBgColor        = RGB(30, 10, 15)
            #<ENHANCED_LABEL>pCtrl.themeTTTextColor      = RGB(255, 241, 242)
            #<ENHANCED_LABEL>pCtrl.themeTTGlowColor       = RGB(251, 113, 133)

            catBgColor   = RGB(76, 5, 25)
            catTextColor = RGB(251, 113, 133)
    ENDSELECT

    #<ENHANCED_LABEL>pCtrl.linkGlowColor = catTextColor

    FOR i = 0 TO #<ENHANCED_LABEL>pCtrl.linkCount - 1
        IF #<ENHANCED_LABEL>pCtrl.links[i].isCategoryHeader THEN
            #<ENHANCED_LABEL>pCtrl.links[i].textColor   = catTextColor
            #<ENHANCED_LABEL>pCtrl.links[i].highlight   = catTextColor
            #<ENHANCED_LABEL>pCtrl.links[i].bgHighlight = catBgColor
        ELSE
            #<ENHANCED_LABEL>pCtrl.links[i].textColor   = #<ENHANCED_LABEL>pCtrl.themeLinkTextColor
            #<ENHANCED_LABEL>pCtrl.links[i].highlight   = #<ENHANCED_LABEL>pCtrl.themeLinkHighlightColor
            #<ENHANCED_LABEL>pCtrl.links[i].bgHighlight = #<ENHANCED_LABEL>pCtrl.themeLinkBgColor
        ENDIF
    NEXT i

    FOR i = 0 TO #<ENHANCED_LABEL>pCtrl.linkBarCount - 1
        #<ENHANCED_LABEL>pCtrl.linkBars[i].textColor   = #<ENHANCED_LABEL>pCtrl.themeLinkTextColor
        #<ENHANCED_LABEL>pCtrl.linkBars[i].highlight   = #<ENHANCED_LABEL>pCtrl.themeLinkHighlightColor
        #<ENHANCED_LABEL>pCtrl.linkBars[i].bgHighlight = #<ENHANCED_LABEL>pCtrl.themeLinkBgColor
    NEXT i

    RedrawWindow(#<ENHANCED_LABEL>pCtrl.hwndCtrl, NULL, NULL, RDW_INVALIDATE | RDW_UPDATENOW)
ENDSUB

SUB EL_IsCollapsed(ptr:POINTER), INT
    POINTER pCtrl
    pCtrl = ptr
    IF pCtrl == NULL THEN RETURN FALSE
    RETURN #<ENHANCED_LABEL>pCtrl.isCollapsed
ENDSUB

SUB EL_GetHeaderHeight(ptr:POINTER), INT
    POINTER pCtrl
    pCtrl = ptr
    IF pCtrl == NULL THEN RETURN 0
    RETURN #<ENHANCED_LABEL>pCtrl.headerHeight
ENDSUB

SUB EL_GetControlHeight(ptr:POINTER), INT
    POINTER pCtrl
    pCtrl = ptr
    IF pCtrl == NULL THEN RETURN 0
    WINRECT rc
    GetWindowRect(#<ENHANCED_LABEL>pCtrl.hwndCtrl, &rc)
    RETURN rc.bottom - rc.top
ENDSUB

SUB EL_GetHeaderTitle(ptr:POINTER, outTitle:POINTER, maxChars:INT), INT
    POINTER pCtrl
    pCtrl = ptr
    IF pCtrl == NULL OR outTitle == NULL THEN RETURN FALSE
    POINTER pTitle = &#<ENHANCED_LABEL>pCtrl.headerTitle
    lstrcpynW(outTitle, pTitle, maxChars)
    RETURN TRUE
ENDSUB

SUB EL_SetScrollOffset(ptr:POINTER, offset:INT), INT
    POINTER pCtrl
    pCtrl = ptr
    IF pCtrl == NULL THEN RETURN FALSE
    IF offset < 0 THEN offset = 0
    #<ENHANCED_LABEL>pCtrl.scrollOffset = offset
    RedrawWindow(#<ENHANCED_LABEL>pCtrl.hwndCtrl, NULL, NULL, RDW_INVALIDATE | RDW_UPDATENOW)
    RETURN TRUE
ENDSUB

SUB EL_GetScrollOffset(ptr:POINTER), INT
    POINTER pCtrl
    pCtrl = ptr
    IF pCtrl == NULL THEN RETURN 0
    RETURN #<ENHANCED_LABEL>pCtrl.scrollOffset
ENDSUB

