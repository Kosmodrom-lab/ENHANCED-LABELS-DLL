SUB EL_ToggleCollapse(ptr:POINTER)
    POINTER pCtrl
    pCtrl = ptr
    IF pCtrl == NULL THEN RETURN

    UINT hCtrlWnd = #<ENHANCED_LABEL>pCtrl.hwndCtrl
    WINRECT rc
    GetWindowRect(hCtrlWnd, &rc)
    INT currentH = rc.bottom - rc.top

    #<ENHANCED_LABEL>pCtrl.isCollapsed = NOT #<ENHANCED_LABEL>pCtrl.isCollapsed

    IF #<ENHANCED_LABEL>pCtrl.isCollapsed == FALSE THEN
        POINT pt
        pt.x = rc.left : pt.y = rc.top
        UINT hParent = GetParent(hCtrlWnd)
        IF hParent <> 0 THEN ScreenToClient(hParent, &pt)
        
        INT targetFullH = #<ENHANCED_LABEL>pCtrl.fullHeight
        MoveWindow(hCtrlWnd, pt.x, pt.y, rc.right - rc.left, targetFullH, FALSE)

        TakeControlSnapshot(ptr)

        #<ENHANCED_LABEL>pCtrl.animHeight = #<ENHANCED_LABEL>pCtrl.headerHeight
        MoveWindow(hCtrlWnd, pt.x, pt.y, rc.right - rc.left, #<ENHANCED_LABEL>pCtrl.headerHeight, TRUE)
    ELSE
        TakeControlSnapshot(ptr)
        #<ENHANCED_LABEL>pCtrl.animHeight = currentH
    ENDIF

    #<ENHANCED_LABEL>pCtrl.isAnimating = TRUE
    SetTimer(hCtrlWnd, EL_TIMER_ID, 16, NULL)
ENDSUB

SUB EL_Resize(ptr:POINTER, x:INT, y:INT, width:INT, height:INT)
    POINTER pCtrl
    pCtrl = ptr
    IF pCtrl == NULL THEN RETURN

    IF #<ENHANCED_LABEL>pCtrl.isCollapsed == FALSE THEN
        #<ENHANCED_LABEL>pCtrl.fullHeight = height
        #<ENHANCED_LABEL>pCtrl.animHeight = height
    ELSE
        #<ENHANCED_LABEL>pCtrl.fullHeight = height
    ENDIF

    INT bodyTop = #<ENHANCED_LABEL>pCtrl.headerHeight
    INT linkBarHeight = IIF(#<ENHANCED_LABEL>pCtrl.useLinkBar == TRUE, #<ENHANCED_LABEL>pCtrl.linkBarHeight, 0)
    INT bodyH = height - bodyTop - linkBarHeight
    INT numCols = IIF(#<ENHANCED_LABEL>pCtrl.linkColumns < 1, 1, #<ENHANCED_LABEL>pCtrl.linkColumns)
    INT itemHeight = 28
    INT gapY = #<ENHANCED_LABEL>pCtrl.linkRowGapY
    INT totalRows = (#<ENHANCED_LABEL>pCtrl.linkCount + numCols - 1) / numCols
    INT contentH = totalRows * (itemHeight + gapY) + 20
    INT maxScroll = contentH - bodyH
    IF maxScroll < 0 THEN maxScroll = 0

    IF #<ENHANCED_LABEL>pCtrl.scrollOffset > maxScroll THEN
        #<ENHANCED_LABEL>pCtrl.scrollOffset = maxScroll
    ENDIF

    INT currentHeight = IIF(#<ENHANCED_LABEL>pCtrl.isCollapsed == TRUE, #<ENHANCED_LABEL>pCtrl.headerHeight, height)
    MoveWindow(#<ENHANCED_LABEL>pCtrl.hwndCtrl, x, y, width, currentHeight, TRUE)
    RedrawWindow(#<ENHANCED_LABEL>pCtrl.hwndCtrl, NULL, NULL, RDW_INVALIDATE | RDW_UPDATENOW)
ENDSUB

