    #<ENHANCED_LABEL>pCtrl.themeTTTextColor = RGB(248, 250, 252)
    #<ENHANCED_LABEL>pCtrl.themeTTGlowColor = RGB(56, 189, 248)

    UINT hCustom = CreateWindowExA(0, &ENHANCED_LABEL_CLASS, NULL, 0x50010000, ptTL.x, ptTL.y, ctrlWidth, ctrlHeight, hwndParent, controlID, GetModuleHandleA(NULL), NULL)
    #<ENHANCED_LABEL>pCtrl.hwndCtrl = hCustom
    SetPropA(hCustom, "EL_pData", pData)
    RedrawWindow(hCustom, NULL, NULL, RDW_INVALIDATE | RDW_UPDATENOW)
    RETURN pData
ENDSUB

