    #<ENHANCED_LABEL>pCtrl.enableClearType = TRUE
    #<ENHANCED_LABEL>pCtrl.enableSmoothing = TRUE
    #<ENHANCED_LABEL>pCtrl.useDualHeader = FALSE
    #<ENHANCED_LABEL>pCtrl.hHeaderDescFont = 0
    #<ENHANCED_LABEL>pCtrl.headerBorderSide = EL_BORDER_NONE
    #<ENHANCED_LABEL>pCtrl.bodyBorderSide = EL_BORDER_NONE
    #<ENHANCED_LABEL>pCtrl.useLinkBar = FALSE
